{
  "expo": {
    "name": "PAG MATCH",
    "slug": "matchup-padel",
    "platforms": ["ios", "android"],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pagmatch.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pagmatch.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFC11A"
        }
      ],
      "expo-video",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "PAG MATCH accède à tes photos pour que tu puisses choisir ta photo de profil.",
          "cameraPermission": "PAG MATCH accède à l'appareil photo pour que tu puisses prendre ta photo de profil."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PAG MATCH utilise ta position pour afficher la distance des parties près de toi. Elle reste sur ton téléphone.",
          "locationAlwaysAndWhenInUsePermission": "PAG MATCH utilise ta position pour afficher la distance des parties près de toi. Elle reste sur ton téléphone.",
          "locationAlwaysPermission": "PAG MATCH utilise ta position pour afficher la distance des parties près de toi. Elle reste sur ton téléphone.",
          "motionUsagePermission": "PAG MATCH peut utiliser les capteurs de mouvement pour préciser ta position.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ]
    ],
    "scheme": "pagmatch",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ebd679cb-dc9f-4208-bcc0-b6b7e2f48bf1"
      }
    },
    "owner": "pagmatch",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ebd679cb-dc9f-4208-bcc0-b6b7e2f48bf1"
    }
  }
}
